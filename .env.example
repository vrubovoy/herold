# Herold — Webmail Client Service

# Docker Compose substitutions. These active values target containers and
# HTTPS through tor; do not source this file into a directly-run backend.
# Full browser navigation target when a visitor has no access token
SCHLUSSEL_WEB_URL=https://auth.localhost
# Schloss home link baked into the frontend image
SCHLOSS_URL=https://localhost
# Glocke URL baked into the frontend image (shared notification bell)
GLOCKE_URL=https://glocke.localhost

# Herold API container
SCHLUSSEL_JWKS_URL=http://schlussel:4000/.well-known/jwks.json
JWT_ISSUER=schlussel
HEROLD_ALLOWED_ORIGINS=https://localhost,https://herold.localhost
# Encrypts stored IMAP/SMTP passwords at rest - generate with
# `openssl rand -base64 32`; replace before startup, same as any other
# secret on this platform.
HEROLD_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key

# Direct backend defaults (override by exporting shell variables; the backend
# does not load .env files):
# DATABASE_PATH=./data/herold.db
# SCHLUSSEL_JWKS_URL=http://localhost:4000/.well-known/jwks.json
# JWT_ISSUER=schlussel
# ALLOWED_ORIGINS=http://localhost:5179
# HEROLD_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key
# HEROLD_OUTBOUND_HOST_ALLOWLIST=mail.internal.example
# HEROLD_OUTBOUND_CIDR_ALLOWLIST=10.20.0.0/16,fd00:20::/64
# HEROLD_MAX_MESSAGE_TEXT_BYTES=262144
# HEROLD_MAX_ACCOUNT_SYNC_BYTES=26214400
# HEROLD_MAX_ACCOUNT_SYNC_MESSAGES=1000
# HEROLD_MAX_ATTACHMENT_BYTES=26214400

# Direct Vite defaults (uncomment to override; Vite does load .env):
# VITE_SCHLUSSEL_URL=http://localhost:4001
# VITE_SCHLOSS_URL=http://localhost:3000
# VITE_GLOCKE_URL=http://localhost:5177
